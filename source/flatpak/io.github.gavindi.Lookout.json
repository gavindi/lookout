{
    "app-id": "io.github.gavindi.Lookout",
    "runtime": "org.gnome.Platform",
    "runtime-version": "49",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "lookout",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",

        "--socket=cups",
        "--system-talk-name=org.opensuse.CupsPkHelper.Mechanism",

        "--talk-name=org.gnome.OnlineAccounts",

        "--talk-name=org.freedesktop.portal.Background",

        "--talk-name=org.kde.StatusNotifierWatcher",

        "--talk-name=org.gnome.Settings",
        "--talk-name=org.gnome.ControlCenter",

        "--talk-name=ca.desrt.dconf",
        "--filesystem=xdg-run/dconf"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/lookout/cargo"
        }
    },
    "modules": [
        {
            "name": "lookout",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline build --release",
                "install -Dm755 target/release/lookout /app/bin/lookout",
                "install -Dm644 data/io.github.gavindi.Lookout.desktop /app/share/applications/io.github.gavindi.Lookout.desktop",
                "install -Dm644 data/io.github.gavindi.Lookout.metainfo.xml /app/share/metainfo/io.github.gavindi.Lookout.metainfo.xml",
                "install -Dm644 data/icons/hicolor/scalable/apps/io.github.gavindi.Lookout.svg /app/share/icons/hicolor/scalable/apps/io.github.gavindi.Lookout.svg",
                "install -Dm644 data/gschema/io.github.gavindi.Lookout.gschema.xml /app/share/glib-2.0/schemas/io.github.gavindi.Lookout.gschema.xml",
                "glib-compile-schemas /app/share/glib-2.0/schemas"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "dest": ".",
                    "exclude": ["target", ".git"]
                },
                "cargo-sources.json"
            ]
        }
    ]
}
